+		assert.equal(original.value, 8);
+		assert(undoStack.length > 0);
+		const undo = undoStack.pop();
+		assert(undo !== undefined);
+		undo.revert();
+		provider.synchronizeMessages();
+		for (const view of views) {
+			assert.deepEqual(
+				[...view.root.items].map((item) => [item.name, item.value]),
+				[
+					["a", 8],
+					["b", 0],
+				],
