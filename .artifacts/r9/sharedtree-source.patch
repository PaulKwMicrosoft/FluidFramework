+					}
+				}
+			},
+		};
+		this.drafts.set(draft, data);
+		return draft;
+	}
+
+	public async publishAdvance(
+		publication: SharedTreeAuthorityPublication,
+	): Promise<ExternalAuthorityOutcome> {
