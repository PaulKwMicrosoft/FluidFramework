+	const initial = controller.capture();
+	const bootstrap = controller.publishAdvance({
+		batchId: "bootstrap",
+		nextCheckpoint: "ready",
+		capture: initial,
+		approvePrefix: initial.editIds.length,
+	});
+	provider.synchronizeMessages();
+	await bootstrap;
+	initial.dispose();
+	views[0].root.value = 1;
+	provider.synchronizeMessages();
