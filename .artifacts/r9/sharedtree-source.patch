+		capture.dispose();
+	});
+
+	it("keeps original authoring context and sender predecessors across prefix correction", async () => {
+		const { provider, trees, views, controllers } = await setup();
+		views[0].root.items.insertAtStart({ name: "accepted", value: 1 });
+		provider.synchronizeMessages();
+		const acceptedNodes = views.map((view) => view.root.items[0]);
+		trees[2].containerRuntime.pauseInboundProcessing();
+		views[2].root.items.removeAt(1);
+		views[2].root.items[1].value = 9;
+		const capture = controllers[0].capture();
+		const draft = controllers[0].createDraft(capture, { afterPrefix: 1 });
+		const root = draft.viewWith(configuration).root;
+		assert.equal(root.items[0].name, "accepted");
+		root.items[0].value = 3;
+		root.items.insertAtStart({ name: "normalization", value: 2 });
+		const receipt = controllers[0].publishAdvance({
