+			batchId,
+			nextCheckpoint,
+			capture,
+			draft: draftId,
+			approvePrefix: count = 0,
+		} = publication;
+		if (this.kernel.checkout.disposed) {
+			throw new UsageError("Authority publication checkout has been disposed");
+		}
+		const captured = this.getCapture(capture);
+		// Do not serve cached successes from an otherwise broken kernel.
+		const current = this.kernel.getExternalAuthorityState();
+		const previous = this.publications.get(batchId);
+		if (previous !== undefined) {
+			if (
+				previous.capture !== capture ||
+				previous.count !== count ||
+				previous.nextCheckpoint !== nextCheckpoint ||
+				previous.draft !== draftId
+			) {
+				throw new UsageError(
+					"Authority batch identity reused with different publication inputs",
+				);
+			}
+			if (draftId !== undefined) {
+				const draft = this.drafts.get(draftId);
+				if (draft === undefined || draft.disposed || draft.checkout.disposed) {
+					throw new UsageError("Authority publication draft has been disposed");
+				}
+				if (draft.checkout.transaction.size > 0) {
+					throw new UsageError("Finish the draft transaction before retrying publication");
+				}
+				if (draft.checkout.mainBranch.getHead() !== previous.head) {
+					throw new UsageError("Authority publication draft changed after sealing");
+				}
+			}
+			const outcome = this.kernel.getExternalAuthorityPublicationOutcome(batchId);
+			return outcome === undefined
+				? previous.completion.promise
+				: outcome === "applied"
+					? "duplicate"
+					: outcome;
+		}
+		if (this.publications.size >= 128) {
+			throw new UsageError("Authority receipt limit exceeded; dispose completed captures");
+		}
+		const base = this.prefixBase(captured, count);
+		if (
+			current.checkpoint === capture.checkpoint &&
+			current.approved.revision !== captured.approved.revision
+		) {
+			throw new UsageError("Captured approved history no longer matches its checkpoint");
+		}
+		if (
+			[batchId, nextCheckpoint].some(
+				(value) => typeof value !== "string" || value.length === 0,
+			) ||
+			nextCheckpoint === capture.checkpoint
+		) {
+			throw new UsageError("An authority advance requires distinct nonempty identifiers");
+		}
+		this.kernel.checkNewExternalAuthorityPublication(batchId);
+		let commits: GraphCommit<SharedTreeChange>[] = [];
+		let head: GraphCommit<SharedTreeChange> | undefined;
+		if (draftId !== undefined) {
+			const draft = this.drafts.get(draftId);
+			if (
+				draft === undefined ||
+				draft.disposed ||
+				draft.sealed ||
+				draft.checkout.disposed ||
+				draft.capture !== capture
+			) {
+				throw new UsageError("Expected an unpublished draft from this capture");
+			}
+			if (draft.afterPrefix !== count || draft.base !== base) {
+				throw new UsageError("Draft authoring base must match the approved captured prefix");
+			}
+			if (draft.checkout.transaction.size > 0) {
+				throw new UsageError("Finish the draft transaction before publishing");
+			}
+			const ancestor = findCommonAncestor(base, [
+				draft.checkout.mainBranch.getHead(),
+				commits,
+			]);
+			assert(ancestor === base, "Authority draft changed its authoring base");
+			if (commits.some((commit) => hasSchemaChange(commit.change))) {
+				throw new UsageError("Authority drafts cannot change schema");
+			}
+			const enriched = draft.checkout.enrich(base, commits);
+			commits = commits.map((commit, index) => ({
+				...commit,
+				change: enriched[index] ?? commit.change,
+			}));
+			captured.references?.sealDraft(draft.checkout);
+			draft.sealed = true;
+			head = draft.checkout.mainBranch.getHead();
+		}
+		const entry: PublicationReceipt = {
+			capture,
+			nextCheckpoint,
+			count,
+			draft: draftId,
+			head,
+			completion: new Deferred<ExternalAuthorityOutcome>(),
+			finished: false,
+		};
+		this.publications.set(batchId, entry);
+		this.kernel
+			.publishExternalAuthority({
+				batchId,
+				expected: capture.checkpoint,
+				next: nextCheckpoint,
+				authoringBase: base.revision,
+				approvedPrefix: captured.commits.slice(0, count).map((commit) => commit.revision),
+				commits,
+			})
+			.then(
+				(outcome) => {
+					entry.finished = true;
+					entry.completion.resolve(outcome);
+					if (captured.disposed) {
+						this.publications.delete(batchId);
+					}
+				},
+				(error: unknown) => {
+					entry.finished = true;
+					entry.completion.reject(error);
+					if (captured.disposed) {
+						this.publications.delete(batchId);
+					}
+				},
+			);
+		return entry.completion.promise;
+	}
+
+	public onStateChanged(listener: () => void): () => void {
+		return this.kernel.onExternalAuthorityChanged(listener);
+	}
+}
+
+const controllers = new WeakMap<SharedTreeKernel, SharedTreeAuthorityController>();
+
+/**
+ * Gets the restricted experimental controller of an explicitly opted-in tree.
+ * This is not an authorization boundary: every Fluid writer is trusted.
+ * @alpha
+ */
+export function getSharedTreeAuthority(tree: ITree): SharedTreeAuthorityController {
+	const kernel = (tree as ITreePrivate).kernel;
+	if (kernel?.externalAuthorityEnabled !== true) {
+		throw new UsageError("External authority mode is not enabled");
+	}
+	let controller = controllers.get(kernel);
+	if (controller === undefined) {
+		controller = new Controller(kernel);
+		controllers.set(kernel, controller);
+	}
+	return controller;
+}
