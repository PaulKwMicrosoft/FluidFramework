+
+import { strict as assert } from "node:assert";
+import { FlushMode } from "@fluidframework/runtime-definitions/internal";
+import { createIdCompressor } from "@fluidframework/id-compressor/internal";
+import { MockFluidDataStoreRuntime } from "@fluidframework/test-runtime-utils/internal";
+import {
+	SchemaFactory,
+	TreeViewConfiguration,
+	treeNodeApi as Tree,
+} from "../../simple-tree/index.js";
+import { TreeStatus } from "../../feature-libraries/index.js";
+import { configuredSharedTree } from "../../treeFactory.js";
+import {
+	getSharedTreeAuthority,
+	type SharedTreeAuthorityController,
+	type SharedTreeChange,
+} from "../../shared-tree/index.js";
+import {
+	readAuthorityEnvelope,
+	readEncodedAdvance,
+	validateAuthorityBootstrap,
+	type AuthorityEnvelope,
+} from "../../shared-tree-core/index.js";
+import { findCommonAncestor, type GraphCommit } from "../../core/index.js";
+import { TestTreeProviderLite, createTestUndoRedoStacks } from "../utils.js";
+import { MockContainerRuntimeWithOpBunching } from "../mocksForOpBunching.js";
+
+const labels = {
+	documentEpoch: "atomic-settlement-document",
+	authorityId: "trusted-normalizer",
+	authorityEpoch: "epoch",
+};
+const sf = new SchemaFactory("atomic-authority-settlement");
+class Item extends sf.object("Item", { name: sf.string, value: sf.number }) {}
+class Items extends sf.array("Items", Item) {}
+class Root extends sf.object("Root", {
+	value: sf.number,
+	other: sf.number,
+	items: Items,
+	slot: sf.optional(Item),
+}) {}
+const configuration = new TreeViewConfiguration({ schema: Root });
+
+async function setup(count = 3) {
+	const factory = configuredSharedTree({
+		minVersionForCollab: "2.80.0",
+		enableDetachedRootEditing: true,
+		externalAuthority: labels,
+	});
+	const provider = new TestTreeProviderLite(
+		count,
+		factory.getFactory(),
+		true,
+		FlushMode.TurnBased,
+	);
+	const trees = provider.trees;
+	const views = trees.map((tree) => tree.viewWith(configuration));
+	views[0].initialize({
+		value: 0,
+		other: 0,
+		items: [
+			{ name: "a", value: 0 },
+			{ name: "b", value: 0 },
+		],
+	});
+	provider.synchronizeMessages();
+	const controllers = trees.map(getSharedTreeAuthority);
+	const capture = controllers[0].capture();
+	const receipt = controllers[0].publishAdvance({
+		batchId: "bootstrap",
+		nextCheckpoint: "ready",
+		capture,
+		approvePrefix: capture.editIds.length,
+	});
+	provider.synchronizeMessages();
+	assert.equal(await receipt, "applied");
+	capture.dispose();
+	return { provider, trees, views, controllers };
+}
+
+function approvedValues(controller: SharedTreeAuthorityController): number[] {
+	const capture = controller.capture();
+	const draft = controller.createDraft(capture);
+	const root = draft.viewWith(configuration).root;
+	const values = [root.value, root.other];
+	draft.dispose();
+	capture.dispose();
+	return values;
+}
+
+describe("atomic authority settlement", () => {
+	it("authors at the exact captured prefix and atomically rebases later P then L", async () => {
+		const { provider, trees, views, controllers } = await setup();
+		const controller = controllers[0];
+		views[0].root.value = 11;
+		provider.synchronizeMessages();
+		views[1].root.other = 20;
+		provider.synchronizeMessages();
+		views[1].root.value = 99;
+		const capture = controller.capture();
+		assert.equal(capture.editIds.length, 2);
+		const originalSnapshot = capture.exportSequenced();
+		const draft = controller.createDraft(capture, { afterPrefix: 1 });
+		const correction = draft.viewWith(configuration);
+		assert.deepEqual([correction.root.value, correction.root.other], [11, 0]);
+		assert.deepEqual(approvedValues(controller), [0, 0]);
+		correction.root.value = 12;
+		correction.root.other = 13;
+		const observed: number[][] = [];
+		const off = trees[2].kernel.checkout.events.on("afterBatch", () => {
+			observed.push([views[2].root.value, views[2].root.other]);
+		});
+		const receipt = controller.publishAdvance({
+			batchId: "normalize",
+			nextCheckpoint: "normalized",
+			capture,
+			approvePrefix: 1,
+			draft,
+		});
+		assert.equal(controller.capture().checkpoint, "ready");
+		assert.deepEqual(observed, []);
+		trees[0].containerRuntime.flush();
+		provider.synchronizeMessages({ flush: false });
+		assert.equal(await receipt, "applied");
+		assert.deepEqual(observed, [[12, 20]], "Only corrected A plus rebased P is exposed");
+		assert.deepEqual(approvedValues(controller), [12, 13]);
+		assert.deepEqual(
+			views.map((view) => [view.root.value, view.root.other]),
+			[
+				[12, 20],
+				[99, 20],
+				[12, 20],
+			],
+		);
+		const settled = controller.capture();
+		assert.deepEqual(settled.editIds, capture.editIds.slice(1));
+		assert.deepEqual(capture.exportSequenced(), originalSnapshot);
+		provider.synchronizeMessages();
+		const acked = controller.capture();
+		assert.equal(acked.editIds.length, 2);
+		assert.equal(acked.editIds[0], capture.editIds[1]);
+		assert(views.every((view) => view.root.value === 99));
+		off();
+		acked.dispose();
+		settled.dispose();
+		draft.dispose();
+		capture.dispose();
+	});
+
+	it("retains later peer P that sequenced after the immutable correction cut", async () => {
+		const { provider, views, controllers } = await setup();
+		views[0].root.value = 1;
+		provider.synchronizeMessages();
+		const capture = controllers[0].capture();
+		const draft = controllers[0].createDraft(capture, { afterPrefix: 1 });
+		draft.viewWith(configuration).root.value = 2;
+		views[1].root.value = 3;
+		provider.synchronizeMessages();
+		const later = controllers[1].capture();
+		const receipt = controllers[0].publishAdvance({
+			batchId: "old-cut",
+			nextCheckpoint: "old-cut-approved",
+			capture,
+			approvePrefix: 1,
+			draft,
+		});
+		provider.synchronizeMessages();
+		assert.equal(await receipt, "applied");
+		assert.deepEqual(approvedValues(controllers[0]), [2, 0]);
+		assert(views.every((view) => view.root.value === 3));
+		const after = controllers[0].capture();
+		assert.deepEqual(after.editIds, later.editIds.slice(1));
+		after.dispose();
+		later.dispose();
+		draft.dispose();
+		capture.dispose();
+	});
+
+	it("preserves authoring checkpoints in an ordinary-correction-ordinary runtime batch", async () => {
