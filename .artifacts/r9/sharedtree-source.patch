+	nativeId: sf.number,
+	value: sf.number,
+}) {}
+class Items extends sf.array("Items", Item) {}
+class Group extends sf.object("Group", { items: Items }) {}
+class Chain extends sf.objectRecursive("Chain", {
+	next: sf.optionalRecursive([() => Chain]),
+}) {}
+class Root extends sf.object("Root", {
+	items: Items,
+	slot: sf.optional(Item),
+	group: sf.optional(Group),
+	value: sf.number,
+}) {}
+const configuration = new TreeViewConfiguration({ schema: Root });
+
+function reference(capture: SharedTreeAuthorityReferenceCapture, node: TreeNode) {
+	const result = capture.reference(node);
+	assert(result.kind === "tracked");
+	return result.reference;
+}
+
+function resolveItem(
+	capture: SharedTreeAuthorityReferenceCapture,
+	ref: SharedTreeAuthorityNodeReference,
+	target: "live" | SharedTreeAuthorityDraft,
+): Item {
+	const result = capture.resolve(ref, target);
+	assert(result.kind === "node");
+	assert(Tree.is(result.node, Item));
+	return result.node;
