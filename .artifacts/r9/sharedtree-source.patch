+	const draft = correction ? controller.createDraft(capture, { afterPrefix: 1 }) : undefined;
+	const draftView = draft?.viewWith(config);
+	if (draftView !== undefined) {
+		draftView.root.value = 2;
+	}
+	const publication: SharedTreeAuthorityPublication = {
+		batchId: "retry",
+		nextCheckpoint: "approved",
+		capture,
+		approvePrefix: 1,
+		draft,
+	};
+	return {
+		provider,
+		trees,
+		views,
+		controllers,
