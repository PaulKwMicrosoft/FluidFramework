+
+	it("retains no-net P and L obligations while approving a no-net prefix and correction", async () => {
+		const { provider, trees, views, controllers } = await setup();
+		views[0].root.value = 1;
+		views[0].root.value = 0;
+		provider.synchronizeMessages();
+		views[1].root.other = 7;
+		views[1].root.other = 0;
+		provider.synchronizeMessages();
+		const capture = controllers[0].capture();
+		assert.equal(capture.editIds.length, 4);
+		const draft = controllers[0].createDraft(capture, { afterPrefix: 2 });
