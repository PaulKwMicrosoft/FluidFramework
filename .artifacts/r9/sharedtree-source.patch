+			nextCheckpoint: "mixed-corrected",
+			capture,
+			approvePrefix: 1,
+			draft,
+		});
+		views[0].root.items[0].value = 9;
+		provider.synchronizeMessages();
+		assert.equal(await receipt, "applied");
+		views[1].root.value = 3;
+		provider.synchronizeMessages();
+		assert(
+			views.every(
+				(view) =>
+					view.root.value === 3 && view.root.other === 7 && view.root.items[0].value === 9,
